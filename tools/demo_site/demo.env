# Settings for the local browser demo (tools/demo_site/README in serve.py).
# The GovTech credentials are NOT here: they come from the git-ignored .env.
DZWEB_PG_DSN=postgresql://dzweb@127.0.0.1:55432/dzweb_test
DZWEB_REDIS_URL=redis://127.0.0.1:56379/0
DZWEB_TERMBASE=tools/demo_site/termbase-empty.json
DZWEB_SITES=tools/demo_site/sites.json
DZWEB_TRANSLATOR=wso2
DZWEB_UPSTREAM_RPS=20
# One browser is one client; the privacy rule needs 3 in production (NFR-304).
DZWEB_DISTINCT_CLIENTS=1
