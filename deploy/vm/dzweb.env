# dzweb settings on the GovTech VM that are not secret (orchestrator/wiring.py
# documents each). Secrets live elsewhere, readable by the app user only:
#   ~/dzweb/.env        GovTech client id and secret, ops token, client-hash key
#   ~/dzweb/.env.infra  PostgreSQL and Redis passwords (deploy/vm/setup-root.sh)
DZWEB_TRANSLATOR=wso2
DZWEB_SITES=deploy/vm/sites.json
# No DCDD termbase yet: an empty one, never the sample with dummy targets.
DZWEB_TERMBASE=tools/demo_site/termbase-empty.json
# Small shared VM: few connections, conservative upstream rate until S0.2
# measures GovTech's real capacity.
DZWEB_PG_POOL_SIZE=5
DZWEB_UPSTREAM_RPS=5
DZWEB_DISTINCT_CLIENTS=3
DZWEB_NUMBERS=model
