{
  "manifest_version": 3,
  "name": "dzweb demo: Dzongkha for the G2C portal",
  "version": "0.1.0",
  "description": "Developer-mode demo of the dzweb widget on g2c.tech.gov.bt, using a dzweb API on this computer.",
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "origin",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://g2c.tech.gov.bt/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "widget/*.js",
        "widget/fonts/*"
      ],
      "matches": [
        "https://g2c.tech.gov.bt/*"
      ]
    }
  ]
}
